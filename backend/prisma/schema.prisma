// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         RoleUser @default(Customer)
  refreshToken String?  @db.Text
  avatarUrl    String?  @db.Text
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  orders        Order[]
  cartItems     CartItem[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @db.VarChar(255)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum RoleUser {
  Customer
  Admin
}

model Category {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  price       Decimal  @db.Decimal(15, 2)
  stock       Int      @db.Integer
  images      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([categoryId])
  @@index([slug])
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  status             OrderStatus @default(Pending)
  totalPrice         Decimal     @db.Decimal(15, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  shippingName       String?     @map("shipping_name")
  shippingPhone      String?     @map("shipping_phone")
  shippingAddress    String?     @map("shipping_address")
  shippingCity       String?     @map("shipping_city")
  shippingPostalCode String?     @map("shipping_postal_code")
  shippingNotes      String?     @map("shipping_notes")

  shippingMethod  String  @default("regular") @map("shipping_method") // regular, express, same_day
  shippingCourier String? @map("shipping_courier") // jne, tiki, pos, dll
  shippingService String? @map("shipping_service") // reg, yes, oke, dll
  shippingCost    Decimal @default(0) @map("shipping_cost") @db.Decimal(15, 2)
  shippingEta     String? @map("shipping_eta") // "3-5 hari", "1-2 hari"
  trackingNumber  String? @map("tracking_number")
  trackingUrl     String? @map("tracking_url")

  midtransOrderId    String?   @unique @map("midtrans_order_id") // order_id yang dikirim ke Midtrans
  snapToken          String?   @map("snap_token") // Snap token untuk client
  snapRedirectUrl    String?   @map("snap_redirect_url") // Redirect URL dari Snap
  paymentType        String?   @map("payment_type") // credit_card, bank_transfer, gopay, dll
  paymentStatus      String?   @map("payment_status") // pending, settlement, capture, expire, cancel
  fraudStatus        String?   @map("fraud_status") // accept, deny, challenge (untuk kartu kredit)
  vaNumber           String?   @map("va_number") // Nomor VA (jika pakai bank transfer)
  transactionId      String?   @map("transaction_id") // transaction_id dari Midtrans
  transactionTime    DateTime? @map("transaction_time") // Waktu transaksi dari Midtrans
  settlementTime     DateTime? @map("settlement_time") // Waktu settlement (jika sudah)
  paymentExpiry      DateTime? @map("payment_expiry") // Expiry time pembayaran
  paymentRawResponse Json?     @map("payment_raw_response") // Raw response dari Midtrans (opsional)

  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItem OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([midtransOrderId])
  @@index([paymentStatus])
}

enum OrderStatus {
  Pending // Menunggu pembayaran
  Paid // Sudah dibayar (dari Midtrans webhook)
  Processing // Sedang diproses/dikemas
  Shipped // Sudah dikirim
  Delivered // Sudah diterima customer
  Cancelled // Dibatalkan
}

enum PaymentOrderType {
  Credit_Card
  Bank_Transfer
  Gopay
  Dana
}

enum PaymentOrderStatus {
  Pending
  Settlement
  Capture
  Expire
  Cancel
}

enum FraudOrderStatus {
  Accept
  Deny
  Challenge
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int      @db.Integer
  priceAtPurchase Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @db.Integer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}
